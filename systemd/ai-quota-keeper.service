[Unit]
Description=AI Quota Keeper：觸發 Codex / Claude Code CLI 並判斷 Reset 券（單次執行）
# 此 unit 以一般使用者身分執行（systemctl --user），不使用 root。

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@
ExecStart=@PROJECT_ROOT@/.venv/bin/python -m ai_quota_keeper run-scheduled
# 兩個 CLI 各 60 秒 + 查券/兌換緩衝
TimeoutStartSec=300
# systemd 的 PATH 很精簡；CLI 若為 node script（如 nvm 安裝），需補上其所在目錄
Environment=PATH=@NODE_BIN@:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Nice=10
